# ── Required ──
# Base64 session string from the pair page. Treat it as a password:
# anyone with it can control the linked WhatsApp account. Never commit your real .env.
SESSION_ID=

# ── Bot identity ──
BOT_NAME=ADEZ XMD

# Single command prefix (e.g. . or !). Leave empty to use . ! /
PREFIX=.

# ── Access ──
# Owner WhatsApp number with country code, no + sign. Owner commands stay off until set.
OWNER_NUMBER=
# public or private
MODE=private

# ── Display ──
# Timezone for the startup alert
TIMEZONE=Africa/Nairobi

# ── Optional ──
# Only needed on hosts that require an HTTP port (Render, Railway, etc.)
# PORT=3000

# Optional: Postgres for persistent session storage. Leave empty to use local files.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
