# Required. Session ID from the pairing page. Treat it as a password; never commit a real value.
SESSION_ID=

# Optional bot settings
BOT_NAME=ADEZ XMD
PREFIX=.
OWNER_NUMBER=
MODE=public
TIMEZONE=Africa/Nairobi

# Optional AI assistant support for .ai, .ask, and .chatgpt
# Create your API key from your OpenAI account dashboard and keep it secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auto-react to incoming messages. Set false to disable.
AUTO_REACT=true

# Optional Postgres storage. If omitted, the bot uses local session files.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
