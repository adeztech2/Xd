# Required. Session ID from the pairing page. Treat it as a password; never commit a real value.
SESSION_ID=

# Strongly recommended. Keeps the session safe across redeploys (Supabase, Neon, Heroku Postgres).
# Supabase: use the "Session pooler" connection string (port 5432), not the transaction pooler.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Bot settings
BOT_NAME=ADEZ MD
PREFIX=.
OWNER_NUMBER=254111783552
MODE=public
TIMEZONE=Africa/Nairobi
BOT_TAGLINE=The best bot in the universe
BOT_PIC=https://u.pone.rs/tntebijt.jpeg
BOT_REPO=adeztech2/adez-md
BOT_CONTACT=Arnold Adez

# Render free plan: your service URL so the bot keeps itself awake (Render sets RENDER_EXTERNAL_URL itself).
# KEEP_ALIVE_URL=https://your-app.onrender.com

# Optional AI assistant support for .ai, .ask, and .chatgpt
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AUTO_REACT=true


# Set to 1 for ONE deploy if replies show "Waiting for this message", then remove it
# RESET_SIGNAL=1
# LOG_LEVEL=warn
